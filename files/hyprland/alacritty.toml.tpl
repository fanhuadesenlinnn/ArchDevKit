[env]
TERM = "xterm-256color"

[window]
padding = { x = 8, y = 8 }
decorations = "None"
opacity = 1.0

[font]
size = 12.0

[font.normal]
family = "IosevkaTerm Nerd Font Mono"
style = "Regular"

[font.bold]
family = "IosevkaTerm Nerd Font Mono"
style = "Bold"

[font.italic]
family = "IosevkaTerm Nerd Font Mono"
style = "Italic"

[colors.primary]
background = "#11111B"
foreground = "#CDD6F4"
