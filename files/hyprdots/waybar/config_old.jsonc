{
  "layer": "top",
  "position": "top",
  "margin-left": 3,
  "margin-right": 3,
  "margin-top": 2,
  "margin-bottom": 0,
  "modules-left": [
    "hyprland/workspaces",
    "cpu",
    "memory",
    "network#speed"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/transparency",
    "custom/wallpaper",
    "wireplumber",
    "backlight",
    "network",
    "battery"
  ],
  "custom/transparency": {
    "format": "TRAN",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/toggle-trans.sh"
  },
  "custom/wallpaper": {
    "format": "WALL",
    "on-click": "~/.config/waybar/scripts/change-wallpaper.sh",
    "tooltip": false,
    "on-click-right": "~/.local/bin/archdevkit-terminal -e ~/.config/waybar/scripts/select-wallpaper.sh"
  },
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "persistent-workspaces": {
      "*": 4
    },
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1"
  },
  "cpu": {
    "interval": 1,
    "format": "CPU {usage}%",
    "on-click": "~/.local/bin/archdevkit-terminal -e btop"
  },
  "memory": {
    "interval": 1,
    "format": "MEM {percentage}%",
    "on-click": "~/.local/bin/archdevkit-terminal -e btop",
    "tooltip-format": "{used}/{total} GiB"
  },
  "network#speed": {
    "interval": 1,
    "format": "{ifname}",
    "format-wifi": "DOWN {bandwidthDownBytes}  UP {bandwidthUpBytes}",
    "format-ethernet": "DOWN {bandwidthDownBytes}  UP {bandwidthUpBytes}",
    "format-disconnected": "NET down",
    "tooltip-format": "{ipaddr}",
    "max-length": 28,
    "min-length": 18
  },
  "backlight": {
    "scroll-step": 5,
    "format": "BL {percent}%",
    "tooltip": true,
    "tooltip-format": "Brightness {percent}%"
  },
  "wireplumber": {
    "max-volume": 200,
    "scroll-step": 5,
    "format": "VOL {volume}%",
    "format-muted": "MUTE",
    "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click": "pamixer -t",
    "tooltip": true,
    "tooltip-format": "{volume}% | {desc}"
  },
  "network": {
    "format-wifi": "WIFI {essid}",
    "format-ethernet": "ETH",
    "format-disconnected": "NET down",
    "interval": 5,
    "tooltip-format-wifi": "Down {bandwidthDownBytes} | Up {bandwidthUpBytes} | {essid}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "~/.config/rofi/wifi/wifi.sh",
    "on-click-right": "~/.local/bin/archdevkit-terminal -e nmtui"
  },
  "battery": {
    "format": "BAT {capacity}%",
    "format-plugged": "AC {capacity}%",
    "format-full": "BAT full",
    "format-alt": "BAT {time}",
    "tooltip-format-discharging": "{power:>1.0f}W -> {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W -> {capacity}%",
    "interval": 5,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    }
  },
  "clock": {
    "format": "{:%H:%M / %h %d}",
    "tooltip": true,
    "tooltip-format": "<tt>{calendar}</tt>"
  }
}
